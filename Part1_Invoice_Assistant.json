    {
      "parameters": {
        "jsCode": "const inv = $('Parse and Validate').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.vendor);\n\nconst norm = v => String(v ?? '').trim().toLowerCase();\nconst num = v => Number(String(v ?? '').replace(/,/g, ''));\n\nconst dup = rows.find(r =>\n  norm(r.vendor) === norm(inv.vendor) && (\n    (inv.invoice_number && norm(r.invoice_number) === norm(inv.invoice_number)) ||\n    (inv.date && num(r.amount) === num(inv.amount) &&\n     norm(r.date) === norm(inv.date) &&\n     norm(r.currency) === norm(inv.currency))\n  )\n);\n\nlet status = inv.status;\nlet notes = inv.notes;\nif (dup) {\n  status = 'DUPLICATE';\n  notes = (notes ? notes + '; ' : '') +\n    'Possible duplicate of invoice ' + (dup.invoice_number || 'N/A') + ' (' + dup.date + ')';\n}\n\nreturn [{ json: { ...inv, status, notes } }];"
      },
      "type": "n8n-nodes-base.code",
