          "cachedResultName": "Gemini 3.1 Flash Lite"
        },
        "text": "You are an invoice data extraction assistant. Read the attached invoice or receipt and return ONLY a valid JSON object, with no markdown and no explanation, using exactly these keys:\n\ndate (format YYYY-MM-DD, or null)\nvendor\ninvoice_number\ndescription\namount (number: the final total including tax, no thousands separators)\ncurrency (ISO code such as USD, EUR, EGP)\ntax (number, or null)\ncategory\n\ncategory must be exactly one of: personnel, travel, equipment, software, events, operational.\nIf a field is not present in the document, use null. Never guess missing values.",
        "inputType": "binary",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        448,
        0
      ],
      "id": "b97fa8e2-c089-4608-9cf5-856910217569",
      "name": "Analyze document",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 3000,
      "credentials": {
        "googlePalmApi": {
          "id": "sfCT4X5zG7AYslq5",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.content?.parts?.[0]?.text ?? $json.text ?? '';\nlet d;\ntry {\n  d = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  return { json: { status: 'NEEDS REVIEW', notes: 'Could not parse AI output', processed_at: new Date().toISOString() } };\n}\n\nconst categories = ['personnel', 'travel', 'equipment', 'software', 'events', 'operational'];\nconst issues = [];\n\nfor (const f of ['date', 'vendor', 'invoice_number', 'description', 'amount', 'currency']) {\n  if (d[f] === null || d[f] === undefined || d[f] === '') issues.push('Missing ' + f);\n}\nif (d.amount != null && (typeof d.amount !== 'number' || d.amount <= 0)) issues.push('Invalid amount');\nif (d.date) {\n  const t = new Date(d.date);\n  if (isNaN(t) || t > new Date()) issues.push('Invalid or future date');\n}\nif (!categories.includes(d.category)) issues.push('Unknown category');\n\nreturn {\n  json: {\n    date: d.date,\n    vendor: d.vendor,\n    invoice_number: d.invoice_number,\n    description: d.description,\n    amount: d.amount,\n    currency: d.currency,\n    tax: d.tax,\n    category: d.category,\n    status: issues.length ? 'NEEDS REVIEW' : 'OK',\n    notes: issues.join('; '),\n    processed_at: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "61e1add4-156a-4914-937e-7b6fb5a0ba55",
