      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst lines = rows.map(r => `${r.category} (${r.currency}): ${r.total_amount} from ${r.invoice_count} invoice(s), tax ${r.total_tax}`);\nreturn [{ json: { text: 'Expense summary (valid invoices only)\\n' + lines.join('\\n') } }];"
      },
