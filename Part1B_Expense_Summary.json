    {
      "parameters": {
        "jsCode": "const num = v => Number(String(v ?? '').replace(/,/g, '')) || 0;\n// Only validated invoices (status OK) are counted. Duplicates and items needing review are excluded.\nconst rows = $input.all().map(i => i.json).filter(r => r.vendor && String(r.status).toUpperCase() === 'OK');\nconst groups = {};\nfor (const r of rows) {\n  const category = r.category || 'uncategorized';\n  const currency = r.currency || 'N/A';\n  const key = category + '|' + currency;\n  if (!groups[key]) groups[key] = { category, currency, invoice_count: 0, total_amount: 0, total_tax: 0 };\n  groups[key].invoice_count += 1;\n  groups[key].total_amount += num(r.amount);\n  groups[key].total_tax += num(r.tax);\n}\nconst now = new Date().toISOString();\nconst items = Object.values(groups)\n  .sort((a, b) => a.category.localeCompare(b.category) || a.currency.localeCompare(b.currency))\n  .map(g => ({ json: { generated_at: now, category: g.category, currency: g.currency,\n    invoice_count: g.invoice_count, total_amount: Math.round(g.total_amount * 100) / 100,\n    total_tax: Math.round(g.total_tax * 100) / 100 } }));\nif (items.length === 0) return [{ json: { generated_at: now, category: 'no valid invoices', currency: '', invoice_count: 0, total_amount: 0, total_tax: 0 } }];\nreturn items;"
      },
